{
  "name": "sophiaagent",
  "version": "0.1.25",
  "description": "Sophia Agent - a focused terminal AI coding assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arain119/SophiaAgent.git"
  },
  "homepage": "https://github.com/Arain119/SophiaAgent",
  "type": "module",
  "author": "Arain119",
  "keywords": [
    "sophia-agent",
    "cli",
    "ai",
    "coding-assistant",
    "terminal",
    "repl"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "bin": {
    "sophia": "dist/cli-bun.js"
  },
  "workspaces": [
    "packages/*",
    "packages/@ant/*"
  ],
  "files": [
    "dist",
    "!dist/*.map",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/postinstall.cjs",
    "scripts/ripgrep-integrity.cjs"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:inspect": "bun run scripts/dev-debug.ts",
    "prepublishOnly": "bun run test:all",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "bun test",
    "test:production": "bun run build && bun run check:bundle && bun dist/cli-bun.js --version",
    "check:bundle": "bun run scripts/check-bundle-integrity.ts",
    "check:unused": "knip-bun --files --dependencies --no-config-hints",
    "health": "bun run scripts/health-check.ts",
    "setup:ripgrep": "node scripts/postinstall.cjs",
    "docs:dev": "npx mintlify dev",
    "typecheck": "tsc --noEmit",
    "test:all": "bun run typecheck && bun run lint && bun run scripts/test-all-isolated.ts && bun run build && bun run health && bun run check:bundle",
    "precheck": "bun run test:all"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "playwright-core": "1.62.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@ant/model-provider": "workspace:*",
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sandbox-runtime": "^0.0.44",
    "@anthropic-ai/sdk": "^0.81.0",
    "@anthropic/ink": "workspace:*",
    "@biomejs/biome": "^2.4.12",
    "@sophia-agent/builtin-tools": "workspace:*",
    "@sophia-agent/mcp-client": "workspace:*",
    "@sophia-agent/workflow-engine": "workspace:*",
    "@commander-js/extra-typings": "^14.0.0",
    "@growthbook/growthbook": "^1.6.5",
    "@langfuse/otel": "^5.1.0",
    "@langfuse/tracing": "^5.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.215.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-prometheus": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.49.0",
    "@types/bun": "^1.3.12",
    "@types/cacache": "^20.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "@types/plist": "^3.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.7.1",
    "@types/stack-utils": "^2.0.3",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "ajv": "^8.18.0",
    "axios": "^1.15.2",
    "cacache": "^20.0.4",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^4.0.0",
    "color-diff-napi": "workspace:*",
    "diff": "^8.0.4",
    "env-paths": "^4.0.0",
    "execa": "^9.6.1",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.3.0",
    "https-proxy-agent": "^8.0.0",
    "ignore": "^7.0.5",
    "iconv-lite": "^0.7.3",
    "image-processor-napi": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.4.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.3.5",
    "marked": "^17.0.6",
    "modifiers-napi": "workspace:*",
    "openai": "^6.34.0",
    "p-map": "^7.0.4",
    "picomatch": "^4.0.4",
    "plist": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.5",
    "react-compiler-runtime": "^1.0.0",
    "semver": "^7.7.4",
    "sharp": "^0.34.5",
    "shell-quote": "^1.8.3",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "undici": "^7.25.0",
    "url-handler-napi": "workspace:*",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@inquirer/prompts": "8.4.2",
    "@xmldom/xmldom": "0.8.13",
    "follow-redirects": "1.16.0",
    "hono": "4.12.15",
    "postcss": "8.5.10",
    "uuid": "14.0.0"
  }
}
